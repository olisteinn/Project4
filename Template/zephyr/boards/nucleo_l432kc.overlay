/ {
    motor_inputs {
        compatible = "gpio-keys";
        enc_c1: enc_c1 { gpios = <&gpiob 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; };
        enc_c2: enc_c2 { gpios = <&gpiob 5 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>; };
        motor_flt: motor_flt { gpios = <&gpiob 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>; };
    };

    motor_outputs {
        compatible = "gpio-leds";
        motor_slp: motor_slp { gpios = <&gpio? ? GPIO_ACTIVE_HIGH>; };
    };

    motor_pwm {
        compatible = "pwm-leds";
        ain1: ain1 { pwms = <&pwm2 1 PWM_USEC(50) PWM_POLARITY_NORMAL>; }; 
        ain2: ain2 { pwms = <&pwm2 2 PWM_USEC(50) PWM_POLARITY_NORMAL>; };  
    };

    aliases {
        c1 = &enc_c1;     // C1 on encoder
        c2 = &enc_c2;     // C2 on encoder
        flt = &motor_flt; // fault pin on motor driver
        slp = &motor_slp; // sleep pin on motor driver
        ain1 = &ain1;     // motor driver input 1
        ain2 = &ain2;     // motor driver input 2
    };
};

